{
  "application": {
    "clock": {
      "colour": {
        "r": 231,
        "g": 103,
        "b": 3
      },
      "ntp": {
        "server": "pool.ntp.org",
        "timezone": "CET-1CEST,M3.5.0,M10.5.0/3",
        "interval": 60
      }
    },
    "gif": {
      "random": true
    }
  },
  "display": {
    "matrix": {
      "panel": {
        "resolution": {
          "x": 64,
          "y": 32
        },
        "count": {
          "x": 2,
          "y": 1
        }
      },
      "pins": {
        "r1": 36,
        "g1": 37,
        "b1": 38,
        "r2": 40,
        "g2": 41,
        "b2": 42,
        "a": 0,
        "b": 1,
        "c": 2,
        "d": 3,
        "e": -1,
        "lat": 18,
        "oe": 16,
        "clk": 15
      },
      "brightness": 90,
      "dimming": {
        "enable": true,
        "min": 10
      }
    }
  },
  "network": {
    "mqtt": {
      "enable": false,
      "server": "mqtt.example.org",
      "port": 1883,
      "credentials": {
        "username": "",
        "password": ""
      },
      "client": {
        "id": ""
      }
    },
    "wifi": {
      "ssid": "",
      "password": ""
    }
  },
  "sensor": {
    "light": {
      "enable": true,
      "pins": {
        "sda": 21,
        "scl": 22
      },
      "lux": 300
    }
  },
  "storage": {
    "sd": {
      "pins": {
        "mosi": 23,
        "miso": 19,
        "clk": 18,
        "cs": 5
      }
    }
  },
  "update": {
    "url": "https://github.com/niklasbhv/esPINDMD/releases/latest/download/manifest.json",
    "interval": 6,
    "auto": false
  }
}
